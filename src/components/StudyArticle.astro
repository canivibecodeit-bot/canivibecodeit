---
/* One study, laid out after the Paper mockup (artboard 24K-0, "W: Ahrefs moat
   study page"): centred cover, stat band, the verdict, the "which moats
   actually held" chart, the figure block, the three cards, "What's inside",
   then the chapters as prose, the methods note and the footer line.

   The page body lives here so that both surfaces render the identical
   article: the public /studies/<slug> route and the token-gated preview at
   /studies/p/<token>/<slug>. The only thing that differs is `base`, the
   study's own URL prefix, which the attachment links hang off.

   Registry: lib/studies.js. Prose and the per-study blocks: the content
   collection entry with the same id. */
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import VerdictBadge from './VerdictBadge.astro';
import { allApps, MOAT_TAG_DESCS, moatsInUse, VERDICTS } from '../lib/apps.js';
import { imageRatios, stackPair, zoomSrc } from '../lib/figures.js';
import { curly, sentenceCase, studyDate, studyDescription, studyUrl } from '../lib/studies.js';
import { rebaseStudyFiles } from '../lib/study-files.js';

/* base: where this rendering of the study lives, no trailing slash. Defaults
   to the public path; the preview passes its own token path. preview: keeps
   the page out of the index (Base also drops analytics on /studies/p/, so a
   token never reaches an analytics payload). */
const { study, entry, base = `/studies/${study.slug}`, preview = false } = Astro.props;

const { Content, headings } = await render(entry);
const fm = entry.data;

/* The body HTML, with the attachment links rebased onto `base` so the
   methods note works from either surface. render() builds <Content /> from
   this same string (these articles carry no local image paths), so the two
   renderings differ in those hrefs and nothing else; if a future Astro
   defers the render and stops filling `rendered`, <Content /> still serves
   the public page correctly. */
const bodyHtml = entry.rendered?.html ? rebaseStudyFiles(entry.rendered.html, study.slug, base) : null;

/* Numbers come from the dataset, never from copy. */
const apps = allApps();
const appCount = apps.length;
const moatCount = Object.keys(MOAT_TAG_DESCS).length;
const subject = study.subjectSlug ? apps.find((a) => a.slug === study.subjectSlug) : null;
const subjectTags = new Set(subject?.moatTags ?? []);

/* "Which moats actually held": share of apps per moat tag whose verdict is
   NOT REALLY, every tag in use, strongest first. The subject's own tags are
   the highlighted rows. */
const held = moatsInUse()
  .map((m) => {
    const tagged = apps.filter((a) => (a.moatTags ?? []).includes(m.tag));
    const kept = tagged.filter((a) => a.verdict === 'no').length;
    return { tag: m.tag, label: m.label.toLowerCase(), n: tagged.length, pct: tagged.length ? Math.round((kept / tagged.length) * 100) : 0 };
  })
  .sort((a, b) => b.pct - a.pct || b.n - a.n);
const heldMax = Math.max(1, ...held.map((r) => r.pct));

/* Contents: the numbered chapters (## 1. … ## 7.). Descriptions come from
   frontmatter `contents` when given, else the first sentence of each
   chapter's opening paragraph. */
// Astro collects heading text AFTER rehype-study has split the chapter
// heading into "01" + "Title", so the text arrives as "01The weekend clone
// test": digits, optional dot, optional space, title.
const chapters = headings
  .filter((h) => h.depth === 2 && /^\d{1,2}\.?\s*\S/.test(h.text))
  .map((h) => {
    const m = h.text.match(/^(\d{1,2})\.?\s*(.*)$/);
    return { ...h, number: Number(m[1]), label: sentenceCase(m[2]) };
  })
  .filter((h) => h.number >= 1);

// First sentence of a chapter's opening paragraph, located in the raw body
// by its number ("## 3. ..."), so heading casing and quotes never matter.
function firstSentence(number) {
  const lines = entry.body.split('\n');
  const re = new RegExp(`^##\\s+${number}\\.\\s`);
  const start = lines.findIndex((l) => re.test(l.trim()));
  if (start < 0) return '';
  for (let i = start + 1; i < lines.length; i++) {
    const t = lines[i].trim();
    if (!t) continue;
    if (t.startsWith('#')) break;
    if (t.startsWith('![') || t.startsWith('[') || t.startsWith('|') || t.startsWith('>')) continue;
    const plain = t.replace(/\*\*|__|`/g, '');
    const m = plain.match(/^(.+?[.?!])(\s|$)/);
    return (m ? m[1] : plain).trim();
  }
  return '';
}
const contents = chapters.map((c, i) => ({ ...c, desc: fm.contents?.[i] ?? firstSentence(c.number) }));

/* Figure-block pairs: each half keeps its own aspect ratio at equal width,
   top-aligned; a pair of very wide strips stacks instead (lib/figures.js).
   In the row, a pair takes the full row; singles share it when there are
   two of them, otherwise a lone single spans it. */
const stackFor = async (f) => (f?.pair ? stackPair(await imageRatios([f.src, f.pair.src])) : false);
const coverStack = await stackFor(fm.cover_figure);
const rows = fm.row_figures ?? [];
const rowStacks = await Promise.all(rows.map(stackFor));
const singles = rows.filter((f) => !f.pair).length;
const rowSpan = (f) => (f.pair || singles < 2 ? 'full' : 'half');

const verdictWord = VERDICTS[fm.verdict]?.label ?? 'NOT REALLY';
const dateline = studyDate(study);
// <title> keeps the spec's lowercase pattern; the page shows the mockup's casing.
const title = `${study.title.toLowerCase()} · moat study no. ${study.number} · Can I Vibecode It?`;
// Derived from the article's own standfirst, never a registry string.
const description = studyDescription(fm.standfirst);
const url = studyUrl(study);
const figNo = (i) => `FIG ${String(i).padStart(2, '0')}`;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: study.title,
    description,
    mainEntityOfPage: url,
    image: `https://canivibecodeit.com${study.ogImage}`,
    ...(study.publishedAt ? { datePublished: study.publishedAt } : {}),
    ...(fm.updated || study.publishedAt ? { dateModified: fm.updated ?? study.publishedAt } : {}),
    author: { '@type': 'Person', name: 'Rob Hallam', url: 'https://x.com/robj3d3' },
    publisher: {
      '@type': 'Organization',
      name: 'Can I Vibecode It?',
      url: 'https://canivibecodeit.com',
      logo: { '@type': 'ImageObject', url: 'https://canivibecodeit.com/logo-512.png' },
    },
    sponsor: { '@type': 'Organization', name: study.sponsor.name, url: study.sponsor.url },
    isAccessibleForFree: true,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'The Death List', item: 'https://canivibecodeit.com/' },
      { '@type': 'ListItem', position: 2, name: 'Studies', item: 'https://canivibecodeit.com/studies' },
      { '@type': 'ListItem', position: 3, name: study.title, item: url },
    ],
  },
];
---

<Base {title} {description} {jsonld} ogImage={study.ogImage} noindex={preview}>
  <main class="wrap study">
    <nav class="crumbs st-crumbs" aria-label="Breadcrumb">
      <a href="/">the death list</a> / <a href="/studies">studies</a> / <span class="here">{study.title.toLowerCase()}</span>
    </nav>

    {/* cover: centred column, mockup rhythm 96 / 24 / 72 */}
    <header class="st-cover">
      {/* the disclosure lives here: study number, "commissioned by", and the
          sponsor's mark inline where the name would be, linked rel=sponsored */}
      <p class="st-eyebrow">
        <span>moat study no. {study.number}</span><span class="st-eyebrow-dot" aria-hidden="true"> · </span><span class="st-eyebrow-by">commissioned by
          {study.sponsor.logo ? (
            <a class="st-eyebrow-mark" href={study.sponsor.url} target="_blank" rel="sponsored noopener" aria-label={study.sponsor.name}>
              <img class="mark-dark" src={study.sponsor.logo} alt="" loading="eager" decoding="async" />
              {study.sponsor.logoLight && <img class="mark-light" src={study.sponsor.logoLight} alt="" loading="eager" decoding="async" />}
            </a>
          ) : (
            <a href={study.sponsor.url} target="_blank" rel="sponsored noopener">{study.sponsor.name}</a>
          )}
        </span>
      </p>
      <h1>{study.title}</h1>
      <p class="st-standfirst">{curly(fm.standfirst)}</p>
      {dateline && <p class="st-dateline">published {dateline}{fm.updated ? ` · updated ${studyDate({ publishedAt: fm.updated })}` : ''}</p>}
    </header>

    {/* stat band */}
    <dl class="st-stats" aria-label="At a glance">
      <div>
        <dd>{appCount.toLocaleString('en-US')}</dd>
        <dt>apps in the dataset</dt>
      </div>
      <div>
        <dd>{moatCount}</dd>
        <dt>moat types scored</dt>
      </div>
      <div>
        <dd>{study.cloneAttempts}</dd>
        <dt>{study.cloneAttempts === 1 ? 'clone attempt' : 'clone attempts'}</dt>
      </div>
      <div>
        <dd class:list={['st-stat-verdict', fm.verdict]}>{verdictWord}</dd>
        <dt>the short version</dt>
      </div>
    </dl>

    {/* the verdict badge, centred like the cover; verdict_text and opener
        render only when the article gives them (operator: the badge sits
        alone above the chart for study no. 1) */}
    <section class="st-verdict" aria-label="Verdict">
      <VerdictBadge verdict={fm.verdict} big />
      {fm.verdict_text?.trim() && <p class="st-verdict-text">{curly(fm.verdict_text)}</p>}
      {fm.opener?.trim() && <p class="st-opener">{curly(fm.opener)}</p>}
    </section>

    {/* which moats actually held: live numbers */}
    <section class="st-band st-chart" aria-labelledby="held-head">
      <div class="st-chart-intro">
        <h2 id="held-head">Which moats actually held.</h2>
        <p>
          Share of apps per moat type that kept a {verdictWord} verdict across {appCount.toLocaleString('en-US')} reviews.
          {subject ? ` ${study.sponsor.name} carries ${subjectTags.size === 1 ? 'one' : subjectTags.size} of the ${moatCount}: the highlighted rows.` : ''}
        </p>
        <p class="st-chart-note">live numbers from the dataset</p>
      </div>
      <ol class="st-bars" aria-label="Held verdicts per moat type">
        {
          held.map((r) => (
            <li class:list={['st-bar-row', { hit: subjectTags.has(r.tag) }]}>
              <a class="st-bar-label" href={`/moat/${r.tag}`}>{r.label}</a>
              <span class="st-bar-track"><i class="st-bar" style={`width: ${Math.max(2, (r.pct / heldMax) * 100)}%`}></i></span>
              <span class="st-bar-pct">{r.pct}%</span>
            </li>
          ))
        }
      </ol>
    </section>

    {/* figure block: the cover figure, then a row of two */}
    {
      (fm.cover_figure || fm.row_figures?.length) && (
        <section class="st-band st-figs" aria-label="Figures">
          {fm.cover_figure && (
            <figure class:list={['st-fig', 'st-fig-cover', { pair: !!fm.cover_figure.pair }]}>
              <div class:list={['st-fig-imgs', { stack: coverStack }]}>
                <a class="fig-zoom" href={zoomSrc(fm.cover_figure.src)} target="_blank" rel="noopener" data-zoom data-caption={fm.cover_figure.caption}>
                  <img src={fm.cover_figure.src} alt={fm.cover_figure.alt} loading="lazy" decoding="async" />
                </a>
                {fm.cover_figure.pair && (
                  <a class="fig-zoom" href={zoomSrc(fm.cover_figure.pair.src)} target="_blank" rel="noopener" data-zoom data-caption={fm.cover_figure.caption}>
                    <img src={fm.cover_figure.pair.src} alt={fm.cover_figure.pair.alt} loading="lazy" decoding="async" />
                  </a>
                )}
              </div>
              {fm.cover_figure.caption && <figcaption>{figNo(1)} · {curly(fm.cover_figure.caption)}</figcaption>}
            </figure>
          )}
          {fm.row_figures?.length > 0 && (
            <div class="st-fig-row">
              {rows.map((f, i) => (
                <figure class:list={['st-fig', rowSpan(f), { pair: !!f.pair }]}>
                  <div class:list={['st-fig-imgs', { stack: rowStacks[i] }]}>
                    <a class="fig-zoom" href={zoomSrc(f.src)} target="_blank" rel="noopener" data-zoom data-caption={f.caption}>
                      <img src={f.src} alt={f.alt} loading="lazy" decoding="async" />
                    </a>
                    {f.pair && (
                      <a class="fig-zoom" href={zoomSrc(f.pair.src)} target="_blank" rel="noopener" data-zoom data-caption={f.caption}>
                        <img src={f.pair.src} alt={f.pair.alt} loading="lazy" decoding="async" />
                      </a>
                    )}
                  </div>
                  {f.caption && <figcaption>{figNo(i + (fm.cover_figure ? 2 : 1))} · {curly(f.caption)}</figcaption>}
                </figure>
              ))}
            </div>
          )}
        </section>
      )
    }

    {/* the three cards */}
    {
      fm.cards && (
        <section class="st-band st-cards" aria-labelledby="cards-head">
          <div class="st-cards-intro">
            {fm.cards.eyebrow && <p class="st-eyebrow left">{fm.cards.eyebrow}</p>}
            <h2 id="cards-head">{curly(fm.cards.title)}</h2>
            {fm.cards.intro && <p>{curly(fm.cards.intro)}</p>}
          </div>
          <div class="st-card-row">
            {fm.cards.items.map((c) => (
              <article class:list={['st-card', { accent: c.accent }]}>
                <p class="st-card-label">{curly(c.label)}</p>
                <h3>{curly(c.title)}</h3>
                <p class="st-card-body">{curly(c.body)}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {/* what's inside */}
    {
      contents.length > 0 && (
        <nav class="st-band st-contents" aria-label="Contents">
          <h2>What's inside.</h2>
          <ol>
            {contents.map((c) => (
              <li>
                <a href={`#${c.slug}`}>
                  <span class="st-c-num">{String(c.number).padStart(2, '0')}</span>
                  <span class="st-c-title">{c.label}</span>
                  <span class="st-c-desc">{curly(c.desc)}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {/* the chapters */}
    <section class="st-band st-prose-wrap">
      <article class="study-prose">
        {bodyHtml ? <Fragment set:html={bodyHtml} /> : <Content />}
      </article>
    </section>

    {/* footer line */}
    <footer class="st-band st-foot">
      <p class="st-foot-line">{curly(fm.footer_line)}</p>
      <a class="st-foot-link" href={study.sponsor.url} target="_blank" rel="sponsored noopener">
        commissioned by {study.sponsor.name} ↗
      </a>
    </footer>
  </main>

  {/* click-to-enlarge overlay for every figure; /js/study-lightbox.js drives it,
      without JS the figure links open the full-size file */}
  <dialog class="study-lightbox" aria-label="Enlarged figure">
    <figure class="lb-frame">
      <button type="button" class="lb-close" data-lb-close aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 3l12 12M15 3L3 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
      </button>
      <img alt="" decoding="async" />
      <figcaption></figcaption>
    </figure>
  </dialog>
</Base>

<script is:inline src={`/js/study-lightbox.js?v=${__BUILD_ID__}`} defer></script>

<style>
  /* Content column = .wrap (1120 like the mockup's 160px margins on 1440),
     which also steps aside for the sponsor rails; sections span it. */
  .st-verdict {
    margin-left: auto;
    margin-right: auto;
  }

  .st-crumbs {
    padding-top: 40px;
  }

  /* ---------- cover ---------- */
  .st-cover {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .st-eyebrow {
    font: 500 14px/1.6 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--primary);
  }

  .st-eyebrow.left {
    text-align: left;
  }

  /* the sponsor's logo inline in the eyebrow, a proper mark rather than a
     cap-height glyph: about 24px tall on a desktop line and 20px on a
     phone, centred on the text line; one file per theme.
     It stays in the text flow, its bottom edge on the text baseline (an
     image's baseline is its bottom edge), 0.9em after "by" so the space
     reads like the one around the middle dot. The eyebrow's 1.6 line height
     leaves room for it; on phones the eyebrow is set as two centred lines on
     purpose (see the 480px rule) so "by" and the mark always share a line. */
  .st-eyebrow-mark {
    --mark-h: clamp(20px, 1.25vw + 6px, 24px);
    display: inline-flex;
    align-items: flex-end;
    vertical-align: baseline;
    margin-left: 0.9em;
    line-height: 0;
  }

  .st-eyebrow-mark img {
    display: block;
    height: var(--mark-h);
    width: auto;
  }

  .st-eyebrow-mark .mark-light,
  :global([data-theme='light']) .st-eyebrow-mark .mark-dark {
    display: none;
  }

  :global([data-theme='light']) .st-eyebrow-mark .mark-light {
    display: inline-block;
  }

  .st-cover h1 {
    font-size: clamp(40px, 5.2vw, 72px);
    line-height: 1.1;
    letter-spacing: -0.035em;
    max-width: 20ch;
  }

  .st-standfirst {
    max-width: 680px;
    font: 16px/26px var(--font-mono);
    color: var(--muted);
  }

  .st-dateline {
    font: 12px/16px var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---------- stat band ---------- */
  .st-stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    /* the mockup's 120px at a full 1120 column; the rails narrow the column
       to ~940px at 1440, so the gap scales down instead of wrapping tiles */
    gap: 40px clamp(40px, 6vw, 120px);
    padding-top: 52px;
    padding-bottom: 52px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .st-stats div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    min-width: 0;
    text-align: center;
  }

  .st-stats dd {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 44px;
    line-height: 54px;
    letter-spacing: -0.035em;
    font-variant-numeric: tabular-nums;
  }

  .st-stats dt {
    max-width: 100%;
    font: 12px/16px var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    text-wrap: balance;
  }

  .st-stat-verdict.no {
    color: var(--no-bg);
  }

  .st-stat-verdict.kinda {
    color: var(--kinda-bg);
  }

  .st-stat-verdict.yes {
    color: var(--primary);
  }

  /* ---------- verdict ---------- */
  .st-verdict {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
    padding-top: 72px;
    max-width: 800px;
  }

  .st-verdict-text {
    font: 16px/26px var(--font-mono);
  }

  .st-opener {
    font: 14px/24px var(--font-mono);
    color: var(--muted);
    max-width: 680px;
  }

  /* ---------- which moats actually held ---------- */
  .st-chart {
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: 96px;
    padding-top: 88px;
    padding-bottom: 40px;
  }

  .st-chart-intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .st-band h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .st-chart-intro p {
    font: 14px/24px var(--font-mono);
    color: var(--muted);
  }

  .st-chart-note {
    font-size: 11px !important;
    line-height: 14px !important;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .st-bars {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 8px;
  }

  .st-bar-row {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr) 48px;
    align-items: center;
    gap: 16px;
    font: 14px/16px var(--font-mono);
    color: var(--muted);
  }

  .st-bar-label {
    text-align: right;
    color: inherit;
  }

  .st-bar-label:hover {
    color: var(--fg);
  }

  .st-bar-track {
    display: block;
    max-width: 400px;
  }

  .st-bar {
    display: block;
    height: 22px;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  .st-bar-row.hit {
    color: var(--fg);
  }

  .st-bar-row.hit .st-bar {
    background: var(--primary);
    border-color: var(--primary);
  }

  .st-bar-row.hit .st-bar-pct {
    color: var(--primary);
    font-weight: 700;
  }

  /* ---------- figures ---------- */
  .st-figs {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 48px;
    padding-bottom: 40px;
  }

  /* a slot with a pair shows both images side by side at equal width, each
     at its own aspect ratio, top-aligned; nothing is cropped or boxed.
     Very wide strips (.stack) sit one above the other at full width. */
  .st-fig.pair .st-fig-imgs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    align-items: start;
  }

  .st-fig.pair .st-fig-imgs.stack {
    grid-template-columns: minmax(0, 1fr);
  }

  .st-fig .fig-zoom {
    display: block;
    min-width: 0;
    cursor: zoom-in;
  }

  .st-fig img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
  }

  .st-fig figcaption {
    padding-top: 18px;
    font: 12px/16px var(--font-mono);
    color: var(--muted);
  }

  .st-fig-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 14px;
    align-items: start;
  }

  /* a pair owns its row; a single shares a row only with another single */
  .st-fig-row .st-fig.full {
    grid-column: 1 / -1;
  }

  /* ---------- the three cards ---------- */
  .st-cards {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-top: 48px;
    padding-top: 88px;
    padding-bottom: 40px;
    border-top: 1px solid var(--border);
  }

  .st-cards-intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 760px;
  }

  .st-cards-intro p:not(.st-eyebrow) {
    font: 14px/24px var(--font-mono);

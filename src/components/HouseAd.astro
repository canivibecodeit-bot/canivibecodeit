---
/* The Attention Playbook house ad: a plain ad block in the same family as
   the rec module, never a sponsor slot. Two shapes of one module: `rail` sits under the
   right sponsor rail's cards (mounted by SponsorRails through the Base
   `houseAd` prop) on viewports with room for it, and `inline` lives in the
   content column, hidden only where the rail shape shows (`hideAtRail`). Whichever shape the
   page shows, the page renders the module once for counting: the instance
   with `count` logs the impression, the other never does. Clicks go through
   the counting redirect (lib/tap.js). */
import { countTapImpression, isTapPlacement, tapLine, tapSales } from '../lib/tap.js';

const { placement, variant = 'inline', count = true, hideAtRail = false } = Astro.props;
if (!isTapPlacement(placement)) throw new Error(`unknown house-ad placement: ${placement}`);

const line = tapLine(await tapSales());
if (count) countTapImpression(placement, Astro.request.headers.get('user-agent'));
---

<aside
  class:list={['tap-ad', `tap-ad-${variant}`, { 'tap-ad-hide-rail': hideAtRail }]}
  aria-label="The Attention Playbook"
  data-tap={placement}
>
  <a class="tap-ad-card" href={`/api/rec/tap?p=${placement}`} target="_blank" rel="nofollow noopener">
    <img class="tap-ad-logo" src="/house/attention-playbook.svg" alt="" width="40" height="40" loading="lazy" />
    <span class="tap-ad-body">
      <span class="rec-eyebrow">The Attention Playbook</span>
      <b class="tap-ad-title">Stop posting into the void.</b>
      <span class="tap-ad-text">You built it. This is how you get it seen on X, and how those views turn into customers. 54 lessons, pre-order now.</span>
      <span class="tap-ad-line">{line}</span>
      <span class="tap-ad-go">Pre-order</span>
    </span>
  </a>
</aside>

---
/* The Attention Playbook's inline module: a plain ad block in the rec
   module's family, in the content column. It is for screens where the
   rails are not displayed; where they are, the house slot in the rail
   carries the ad (components/HouseSlotCard.astro) and this module is
   hidden, so a page never shows it twice.

   Counting: with the house slot on, the slot's card logs the page's one
   impression and this module logs none. With the slot switched off
   (HOUSE_TAP_SLOT=0) this module counts under its own placement, as it
   did before the slot existed. Clicks go through the counting redirect
   (lib/tap.js); the link opts out of the client router's prefetch. */
import { tapSlotOn } from '../lib/sponsors.js';
import { countTapImpression, isTapPlacement, tapLine, tapSales } from '../lib/tap.js';

const { placement } = Astro.props;
if (!isTapPlacement(placement)) throw new Error(`unknown house-ad placement: ${placement}`);

const line = tapLine(await tapSales());
if (!tapSlotOn()) {
  countTapImpression(placement, Astro.request.headers.get('user-agent'));
  // Noted for the flood guard: a served copy of this page counts the same.
  Astro.locals.counted?.push({ k: 'tap', placement });
}
---

<aside class="tap-ad tap-ad-inline" aria-label="The Attention Playbook" data-tap={placement}>
  <a class="tap-ad-card" href={`/api/rec/tap?p=${placement}`} target="_blank" rel="nofollow noopener" data-astro-prefetch="false">
    <img class="tap-ad-logo" src="/house/attention-playbook.svg" alt="" width="40" height="40" loading="lazy" />
    <span class="tap-ad-body">
      <span class="rec-eyebrow">The Attention Playbook</span>
      <b class="tap-ad-title">Stop posting into the void.</b>
      <span class="tap-ad-text">You built it. This is how you get it seen on X, and how those views turn into customers. 54 lessons, pre-order now.</span>
      <span class="tap-ad-line">{line}</span>
      <span class="tap-ad-go">Pre-order</span>
    </span>
  </a>
</aside>

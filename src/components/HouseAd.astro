---
/* The Attention Playbook house ad, never a sponsor slot. Two shapes of one
   module. `inline` is a plain ad block in the rec module's family, in the
   content column, hidden only where the rail shape shows (`hideAtRail`).
   `rail` is a card of the sponsor cards' geometry and type scale under the
   right rail's cards (mounted by SponsorRails through the Base `houseAd`
   prop) on viewports with room for it: logo, name, tagline, one short
   line, the whole card the link. It carries its own class names, never
   `sp-card`, so sponsor click tracking cannot mistake it for a slot.
   Whichever shape the page shows, the page renders the module once for
   counting: the instance with `count` logs the impression, the other never
   does. Clicks go through the counting redirect (lib/tap.js). Both links
   opt out of the client router's prefetch: the redirect is same-origin, so
   a hover would otherwise fetch it and reach the counter. */
import { countTapImpression, isTapPlacement, tapLine, tapLineShort, tapSales } from '../lib/tap.js';

const { placement, variant = 'inline', count = true, hideAtRail = false } = Astro.props;
if (!isTapPlacement(placement)) throw new Error(`unknown house-ad placement: ${placement}`);

const sales = await tapSales();
const line = tapLine(sales);
const shortLine = tapLineShort(sales);
const isRail = variant === 'rail';
if (count) countTapImpression(placement, Astro.request.headers.get('user-agent'));
---

<aside
  class:list={['tap-ad', `tap-ad-${variant}`, { 'tap-ad-hide-rail': hideAtRail }]}
  aria-label="The Attention Playbook"
  data-tap={placement}
>
  {isRail && (
    <a
      class="tap-rail-card"
      href={`/api/rec/tap?p=${placement}`}
      target="_blank"
      rel="nofollow noopener"
      data-astro-prefetch="false"
      aria-label="The Attention Playbook: Stop posting into the void. Pre-order."
    >
      <img class="tap-rail-icon" src="/house/attention-playbook.svg" alt="" width="26" height="26" loading="lazy" />
      <span class="tap-rail-name">The Attention Playbook</span>
      <span class="tap-rail-tag">Stop posting into the void.</span>
      <span class="tap-rail-line">{shortLine}</span>
    </a>
  )}
  {!isRail && (
  <a class="tap-ad-card" href={`/api/rec/tap?p=${placement}`} target="_blank" rel="nofollow noopener" data-astro-prefetch="false">
    <img class="tap-ad-logo" src="/house/attention-playbook.svg" alt="" width="40" height="40" loading="lazy" />
    <span class="tap-ad-body">
      <span class="rec-eyebrow">The Attention Playbook</span>
      <b class="tap-ad-title">Stop posting into the void.</b>
      <span class="tap-ad-text">You built it. This is how you get it seen on X, and how those views turn into customers. 54 lessons, pre-order now.</span>
      <span class="tap-ad-line">{line}</span>
      <span class="tap-ad-go">Pre-order</span>
    </span>
  </a>
  )}
</aside>

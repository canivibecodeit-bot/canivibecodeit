---
import HouseSlotCard from './HouseSlotCard.astro';
import SponsorCard from './SponsorCard.astro';
import { recordImpressions } from '../lib/impressions.js';
import { composeRails, getBoard, nextRunMonthName } from '../lib/sponsors.js';

// The Attention Playbook holds a house slot of its own in the sequence
// (composeRails puts it immediately above the open unit). Every card in
// both rails is the same height: Base's <head> carries the sizing rules for
// the number of rows (lib/sponsors.js, rail sizing).
const nextMonthLabel = nextRunMonthName();

const board = await getBoard();
// This component renders exactly once per page, which makes it the impression
// counter: one impression per live slot per page load. Private surfaces
// (admin, a sponsor refreshing their own pages) don't count.
const isPrivatePage =
  Astro.url.pathname.startsWith('/admin') ||
  Astro.url.pathname.startsWith('/sponsor/details') ||
  Astro.url.pathname.startsWith('/sponsor/stats') ||
  Astro.url.search.includes('token=');
if (!isPrivatePage) {
  const liveIds = board.live.map((s) => s.id);
  recordImpressions(liveIds, Astro.request.headers.get('user-agent'));
  // Noted for the flood guard: a served copy of this page counts the same.
  Astro.locals.counted?.push({ k: 'sponsor', ids: liveIds });
}
/* Rail composition v2 (operator decision, Sep 2): money cards pinned per
   side, house cards float to the shorter rail, and exactly ONE open unit on
   the whole board appended last to the shorter rail. The rules live in
   composeRails (sponsors.js) so they stay testable and shared with the
   tapes. Full availability lives on /sponsor, never as empty units here. */
const composed = composeRails(board);
const left = composed.left;
const right = composed.right;
const total = board.slots.length;
// Only an all-running board gets the sold-out card; anything held shows a
// reserved card instead, so the rails already carry something clickable.
// It goes on BOTH sides so the rails stay the same height.
const showSoldOut = board.allLive;
---

{/* Bottom meta card policy: renders only when the board is fully live — the
    buy-path when no open-slot cards exist; do not make permanent (operator
    decision 2026-09-02). While any slot is open, the open-slot cards ARE
    the buy buttons and a bottom CTA is redundant. The 'more' card variant
    in SponsorCard.astro stays implemented for when the board sells out. */}
<aside class="sp-rail sp-left" aria-label="Sponsors, left">
  {left.map((slot, i) => (slot.state === 'tap' ? <HouseSlotCard count={!isPrivatePage} /> : <SponsorCard {slot} index={i} />))}
  {showSoldOut && <SponsorCard soldOut septLeft={total - board.prebookedCount} nextMonth={nextMonthLabel} total={total} index={left.length} />}
</aside>

<aside class="sp-rail sp-right" aria-label="Sponsors, right">
  {right.map((slot, i) => (slot.state === 'tap' ? <HouseSlotCard count={!isPrivatePage} /> : <SponsorCard {slot} index={i + left.length} />))}
  {showSoldOut && <SponsorCard soldOut septLeft={total - board.prebookedCount} nextMonth={nextMonthLabel} total={total} index={total} />}
</aside>

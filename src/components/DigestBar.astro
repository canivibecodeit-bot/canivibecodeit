<section class="digest-bar" id="digest-bar" aria-label="Weekly digest">
  <p class="db-label"><i>$</i>five vibe-coding tips + what died. thursdays.</p>
  <form method="post" action="/api/waitlist" data-digest>
    <label class="hp" aria-hidden="true">
      Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
    <input type="hidden" name="source" value="bar" />
    <input
      type="email"
      name="email"
      required
      placeholder="you@wherever.com"
      aria-label="Email address"
    />
    <button class="btn primary" type="submit">get thursday's</button>
    <button class="db-close" type="button" data-digest-bar-dismiss aria-label="dismiss">✕</button>
  </form>
</section>

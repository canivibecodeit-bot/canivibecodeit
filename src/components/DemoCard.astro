---
/* One curated demo on a model showcase: media first, one line of text,
   avatar and handle, a source badge with the real platform mark. The post is
   third-party content: the card links out with rel nofollow, media is our
   self-hosted copy. Videos never autoplay; a GIF (an mp4 loop) does, muted. */
const { demo: d } = Astro.props;

const SOURCE = {
  x: { label: 'FROM X', path: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z' },
  github: { label: 'FROM GITHUB', path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12' },
  youtube: { label: 'FROM YOUTUBE', path: 'M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z' },
  web: { label: 'FROM THE WEB', path: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm7.9 9h-3a15.7 15.7 0 0 0-1.3-6 8 8 0 0 1 4.3 6ZM12 4c.9 1.1 2.2 3.5 2.6 7H9.4C9.8 7.5 11.1 5.1 12 4ZM4.1 13h3c.2 2.3.7 4.4 1.3 6a8 8 0 0 1-4.3-6Zm3-2h-3a8 8 0 0 1 4.3-6c-.6 1.6-1.1 3.7-1.3 6Zm4.9 9c-.9-1.1-2.2-3.5-2.6-7h5.2c-.4 3.5-1.7 5.9-2.6 7Zm3.6-1a15.7 15.7 0 0 0 1.3-6h3a8 8 0 0 1-4.3 6Z' },
};
const src = SOURCE[d.source] ?? SOURCE.web;
const hasMedia = d.media_kind !== 'none' && d.media_url;
const ratio = d.width && d.height ? `${d.width} / ${d.height}` : '16 / 9';
const isVideo = d.media_kind === 'video';
const isGif = d.media_kind === 'gif';
---

<article class="dc" data-demo={d.id}>
  {hasMedia && (
    <div class="dc-media" style={`aspect-ratio: ${ratio};`}>
      {isVideo || isGif ? (
        <>
          <video
            muted
            playsinline
            preload="metadata"
            poster={d.poster_url ?? undefined}
            loop={isGif}
            autoplay={isGif}
            data-dc-video
          >
            <source src={d.media_url} type="video/mp4" />
          </video>
          {isVideo && (
            <>
              <button class="dc-play" type="button" aria-label="play the clip" data-dc-play>
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
              </button>
              {/* revealed by showcase.js when the clip cannot play */}
              <a class="dc-watch" href={d.source_url} target="_blank" rel="noopener nofollow" data-dc-watch hidden>watch on X ↗</a>
            </>
          )}
          {isGif && <span class="dc-kind">GIF</span>}
        </>
      ) : (
        <a href={d.source_url} target="_blank" rel="noopener nofollow">
          <img src={d.media_url} alt="" width={d.width ?? undefined} height={d.height ?? undefined} loading="lazy" />
        </a>
      )}
    </div>
  )}
  <a class="dc-body" href={d.source_url} target="_blank" rel="noopener nofollow">
    {d.text && <span class="dc-text">{d.text}</span>}
    <span class="dc-foot">
      <span class="dc-author">
        {d.author_avatar_url ? (
          <img class="dc-avatar" src={d.author_avatar_url} alt="" width="22" height="22" loading="lazy" />
        ) : (
          <span class="dc-avatar dc-avatar-blank" aria-hidden="true"></span>
        )}
        <span class="dc-handle">@{d.author_handle}</span>
      </span>
      <span class="dc-badge">
        <svg width="10" height="10" viewBox="0 0 24 24" aria-hidden="true"><path d={src.path} fill="currentColor" /></svg>
        <span>{src.label}</span>
        <span aria-hidden="true">↗</span>
      </span>
    </span>
  </a>
</article>

<style>
  .dc {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    break-inside: avoid;
    margin-bottom: 20px;
  }

  .dc-media {
    position: relative;
    width: 100%;
    background: var(--surface-2);
    overflow: hidden;
  }

  .dc-media img,
  .dc-media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dc-media a {
    display: block;
    height: 100%;
  }

  .dc-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 48px;
    height: 48px;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .dc-play:hover {
    background: rgba(0, 0, 0, 0.7);
    transform: translate(-50%, -50%) scale(1.06);
  }

  .dc.playing .dc-play,
  .dc.broken .dc-play {
    display: none;
  }

  /* the fallback affordance for a clip that will not play. Scoped to
     .dc-media so it outranks the generic .dc-media a (block, 100% tall)
     and stays a pill, not a full-size overlay; visibility is driven by the
     card's broken class, set by showcase.js, not the hidden attribute. */
  .dc-media .dc-watch {
    display: none;
    position: absolute;
    left: 50%;
    top: 50%;
    height: auto;
    transform: translate(-50%, -50%);
    padding: 9px 14px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    font: 600 12.5px var(--font-mono);
    text-decoration: none;
    white-space: nowrap;
  }

  .dc.broken .dc-media .dc-watch {
    display: inline-block;
  }

  .dc-kind {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 2px 6px;
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font: 700 10px var(--font-mono);
    letter-spacing: 0.06em;
  }

  .dc-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px 16px 16px;
    color: var(--fg);
    text-decoration: none;
  }

  .dc-text {
    font-size: 14px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dc-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .dc-author {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .dc-avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .dc-avatar-blank {
    display: inline-block;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  .dc-handle {
    font: 12.5px var(--font-mono);
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dc-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 7px 3px 6px;
    border: 1px solid var(--border);
    border-radius: 4px;
    font: 10.5px var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--muted);
    flex-shrink: 0;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .dc-body:hover .dc-badge {
    color: var(--fg);
    border-color: var(--muted);
  }
</style>

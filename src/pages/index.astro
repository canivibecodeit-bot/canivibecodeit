---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
import AppRow from '../components/AppRow.astro';
import VisitorGlobe from '../components/VisitorGlobe.astro';
import DigestCard from '../components/DigestCard.astro';
import { allApps, appsWithAlternativesPage, topCategories } from '../lib/apps.js';
import { voteCounts } from '../lib/db.js';

const votes = await voteCounts();
const apps = allApps().sort(
  (a, b) =>
    votes(b.slug) - votes(a.slug) ||
    (b.pagePriority ?? 3) - (a.pagePriority ?? 3) ||
    a.name.localeCompare(b.name)
);
const cats = topCategories();

// Strip under the chips: numbers computed from the same source as the
// /alternatives hub, so the claim can never drift from the pages.
const altApps = appsWithAlternativesPage();
const totalAlts = altApps.reduce((s, a) => s + a.alternatives.length, 0);

const title = 'Can I Vibecode It? · what AI can rebuild, what survives';
const description = `The live scoreboard of what AI can and can't replace, and which moats actually hold. Honest verdicts on ${apps.length} apps, the exact prompt to run, free.`;

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Can I Vibecode It?',
    url: 'https://canivibecodeit.com',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: 'https://canivibecodeit.com/?q={search_term_string}',
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'The Death List',
    itemListElement: apps.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.name,
      url: `https://canivibecodeit.com/${a.slug}`,
    })),
  },
];
---

<Base {title} {description} {jsonld}>
  <section class="hero">
    <h1>Can I vibecode <span class="blank">___</span>?</h1>
    <p class="sub">
      {apps.length} apps. One question each: can AI build you a replacement today, or is it
      still worth paying for?
    </p>
    <div class="search-wrap">
      <div class="search">
        <span class="chevron">&gt;</span>
        {/* Placeholder stays short on purpose: mobile bumps this input to 16px
            (the iOS zoom guard), which clipped the old "(N on the list)" at
            390px and narrower, and would clip harder once the count goes four
            digits. The full count is in the line right above the box. */}
        <input
          type="search"
          id="search"
          placeholder={`type an app… (${apps.length})`}
          autocomplete="off"
          aria-label="Search apps"
          role="combobox"
          aria-expanded="false"
          aria-controls="search-results"
        />
        <span class="cursor" aria-hidden="true"></span>
      </div>
      <div class="search-results" id="search-results" role="listbox"></div>
    </div>
    <p class="search-miss" id="no-results" role="status">
      <span class="badge kinda" style="font-size: 10px;">NOT LISTED YET</span>
      <a href="https://github.com/canivibecodeit/canivibecodeit/blob/main/CONTRIBUTING.md">submit it as a PR ↗</a>
      <span class="miss-note">verdicts are added daily · thousands more on the way</span>
    </p>
    <nav class="chips" aria-label="Categories">
      {/* #chips holds only the filtering chips: clicks inside it filter in place
          instead of navigating, so the links out sit outside the group. */}
      <span id="chips" style="display: contents;">
        <a class="chip active" href="/" data-cat="">⚡ all</a>
        {
          cats.map((c) => (
            <a class="chip" href={`/category/${c.slug}`} data-cat={c.slug}>
              {c.emoji} {c.label.toLowerCase()}
            </a>
          ))
        }
      </span>
      <a class="chip chip-new" href="/alternatives">🚪 escape hatches <span class="new-tag">NEW</span></a>
      <a class="chip" href="/moats">🏰 moats</a>
      <a class="chip" href="/categories">all categories →</a>
    </nav>
    <a class="hatch-strip" href="/alternatives">
      <span class="hs-copy">
        every verdict now has an escape hatch: {totalAlts.toLocaleString('en-US')} free
        alternatives across {altApps.length} apps
      </span>
      <span class="hs-cta">browse them →</span>
    </a>
  </section>

  <Ticker />

  <main class="wrap" id="death-list">
    <div class="list-head">
      <h2>The Death List</h2>
      <span class="note">ranked by "I replaced this" votes</span>
    </div>
    <div class="verdict-filter" id="verdict-filter" role="group" aria-label="Filter by verdict">
      <span class="microlabel">verdict</span>
      <button class="vchip all active" data-verdict="">all</button>
      <button class="vchip yes" data-verdict="yes">YES</button>
      <button class="vchip kinda" data-verdict="kinda">KINDA</button>
      <button class="vchip no" data-verdict="no">NOT REALLY</button>
      <span class="microlabel team-label">team of</span>
      <span class="team-stepper">
        <button type="button" class="team-step" data-step="-1" aria-label="Smaller team">−</button>
        <input
          type="number"
          id="team-size"
          class="team-size"
          value="1"
          min="1"
          max="999"
          step="1"
          inputmode="numeric"
          aria-label="Team size, recalculates per-seat prices"
        />
        <button type="button" class="team-step" data-step="1" aria-label="Bigger team">+</button>
      </span>
      <button class="vchip all" id="sort-toggle" data-sort="votes">sort: votes</button>
      <span class="note" id="filter-count"></span>
    </div>
    <div class="thead microlabel">
      <span class="c-app">app</span>
      <span class="c-cat">category</span>
      <span class="c-price">price</span>
      <span class="c-verdict">verdict</span>
      <span class="c-votes">replaced it</span>
      <span class="c-save"></span>
    </div>
    <div id="rows">
      {
        apps.map((app, i) => (
          <Fragment>
            <AppRow {app} rank={i + 1} votes={votes(app.slug)} />
            {i === 9 && <VisitorGlobe />}
          </Fragment>
        ))
      }
    </div>
  </main>

  <DigestCard source="home" />
</Base>

<style>
  .team-label {
    margin-left: 6px;
  }

  /* The native number-input spinners don't match anything else on the page,
     so the stepper owns the border and ships its own −/+ buttons. */
  .team-stepper {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--border);
    border-radius: 5px;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .team-stepper:focus-within {
    border-color: var(--primary);
  }

  .team-step {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    width: 26px;
    padding: 6px 0;
    color: var(--muted);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .team-step:hover {
    color: var(--fg);
  }

  .team-step:active {
    transform: scale(0.9);
  }

  .team-size {
    font-family: var(--font-mono);
    font-size: 12px;
    width: 34px;
    padding: 6px 0;
    border: 0;
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
    background: transparent;
    color: var(--fg);
    text-align: center;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .team-size::-webkit-outer-spin-button,
  .team-size::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .team-size:focus {
    outline: none;
  }

  @media (max-width: 760px) {
    /* iOS zooms into any focused input with font-size below 16px */
    .team-size {
      font-size: 16px;
      width: 44px;
    }

    /* A finger needs more than 26px */
    .team-step {
      width: 34px;
    }
  }
</style>
